":"هِيَ","id":"34bc9987"},{"ar":"الطُّلَّابُ","en":"Which pronoun?","ar_q":null,"star":false,"mode":"choose","options":["هُمْ","هُنَّ","هِيَ"],"answer":"هُمْ","model":"هُمْ","id":"e936e5b0"},{"ar":"الْمُعَلِّمَةُ","en":"Which pronoun?","ar_q":null,"star":false,"mode":"choose","options":["هُوَ","هِيَ","هُمْ"],"answer":"هِيَ","model":"هِيَ","id":"188c7406"},{"ar":"الْإِمَامُ","en":"Which pronoun?","ar_q":null,"star":false,"mode":"choose","options":["هُوَ","هِيَ","هُمْ"],"answer":"هُوَ","model":"هُوَ","id":"8f0440f2"},{"ar":"الْبَنَاتُ","en":"Which pronoun?","ar_q":null,"star":false,"mode":"choose","options":["هُمْ","هُنَّ","هِيَ"],"answer":"هُنَّ","model":"هُنَّ","id":"9ddcae79"},{"ar":"مَرْيَمُ","en":"Which pronoun?","ar_q":null,"star":false,"mode":"choose","options":["هُوَ","هِيَ","هُنَّ"],"answer":"هِيَ","model":"هِيَ","id":"be718095"},{"ar":"الرِّجَالُ","en":"Which pronoun?","ar_q":null,"star":false,"mode":"choose","options":["هُمْ","هُنَّ","هُوَ"],"answer":"هُمْ","model":"هُمْ","id":"167c448b"}]},{"name":"C","kind":"rows","role":"skill","en":"Choose the statement that matches the pronoun.","ins":"اِخْتَرِ الْجَوَابَ الصَّحِيحَ.","review":false,"items":[{"ar":"هِيَ ____","en":"(sad)","ar_q":"أَيُّ خَبَرٍ يُنَاسِبُ الضَّمِيرَ؟","star":false,"mode":"choose","options":["حَزِينٌ","حَزِينَةٌ"],"answer":"حَزِينَةٌ","model":"حَزِينَةٌ","id":"c74738c4"},{"ar":"نَحْنُ ____","en":"(happy)","ar_q":"أَيُّ خَبَرٍ يُنَاسِبُ الضَّمِيرَ؟","star":false,"mode":"choose","options":["سَعِيدٌ","سَعِيدُونَ"],"answer":"سَعِيدُونَ","model":"سَعِيدُونَ","id":"07b5c431"},{"ar":"أَنْتِ ____","en":"(rich)","ar_q":"أَيُّ خَبَرٍ يُنَاسِبُ الضَّمِيرَ؟","star":false,"mode":"choose","options":["غَنِيٌّ","غَنِيَّةٌ"],"answer":"غَنِيَّةٌ","model":"غَنِيَّةٌ","id":"4eb5ed00"},{"ar":"هُمْ ____","en":"(poor)","ar_q":"أَيُّ خَبَرٍ يُنَاسِبُ الضَّمِيرَ؟","star":false,"mode":"choose","options":["فَقِيرٌ","فَقِيرُونَ"],"answer":"فَقِيرُونَ","model":"فَقِيرُونَ","id":"700e3d3d"},{"ar":"هُنَّ ____","en":"(ha
6b46"},{"mode":"grid","headers":["Masculine","Feminine"],"cells":[{"answer":"أَخ","options":["طَالِب","أَخ","وَلَد","أَب"]},{"given":"أُخْت"}],"id":"4a75ea23"},{"mode":"grid","headers":["Masculine","Feminine"],"cells":[{"given":"كَاتِب"},{"answer":"كَاتِبَة","options":["أُخْت","بِنْت","أُمّ","كَاتِبَة"]}],"id":"58a2f081"}]},{"name":"C","kind":"rows","role":"skill","en":"Which word does not belong with the others (gender)?","ins":"مَا الْكَلِمَةُ الْمُخْتَلِفَةُ؟","review":false,"items":[{"ar":"أُمّ  ·  أُخْت  ·  أَب  ·  بِنْت","en":"Circle the odd one.","ar_q":null,"star":false,"mode":"choose","options":["رِبَاط","قَلَم","أَب"],"answer":"أَب","model":"أَب (masculine; the others are feminine)","note":"masculine; the others are feminine","id":"96319a18"},{"ar":"مَدْرَسَة  ·  مَدِينَة  ·  رِبَاط  ·  مَكْتَبَة","en":"Circle the odd one.","ar_q":null,"star":false,"mode":"choose","options":["رِبَاط","أَب","قَلَم"],"answer":"رِبَاط","model":"رِبَاط (masculine; the others are feminine)","note":"masculine; the others are feminine","id":"81685020"},{"ar":"شَمْس  ·  يَد  ·  قَلَم  ·  عَيْن","en":"Circle the odd one.","ar_q":null,"star":false,"mode":"choose","options":["قَلَم","رِبَاط","أَب"],"answer":"قَلَم","model":"قَلَم (masculine; the others are feminine)","note":"masculine; the others are feminine","id":"3945d08a"}]},{"name":"D","kind":"match","role":"skill","en":"Match each word with its meaning.","ins":"صِلْ كُلَّ كَلِمَةٍ بِمَعْنَاهَا.","review":false,"items":[{"mode":"match","pairs":[["أَب","father"],["أُمّ","mother"],["أَخ","brother"],["أُخْت","sister"],["وَلَد","boy"]],"id":"7ade92e1"},{"mode":"match","pairs":[["بِنْت","girl"],["مُعَلِّم","teacher (man)"],["مُعَلِّمَة","teacher (woman)"]],"id":"0c206af4"}]},{"name":"E","kind":"rows","role":"mistake","en":"Find the mistake.","ins":"جِدِ الْخَطَأَ وَصَحِّحْهُ.","review":false,"items":[{"ar":"عَيْن  =  masculine (no ـَة)","en":"What is wrong?","ar_q":null,"star":false,"mode":"self","model":"No. عَيْن (eye) is one of th